{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steak",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // steakstandings.com itself redirects to www via a Redirect Rule on the zone
  "routes": [{ "pattern": "www.steakstandings.com", "custom_domain": true }],
  // Listing routes turns workers.dev off by default; keep it for testing
  "workers_dev": true,
  "assets": {
    // The Worker reads finished seasons' saved MFL exports (public/mfl)
    "binding": "ASSETS",
    // Serve index.html for client-side routes like /live and /matchups
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // The live NBA season's running games tally (gamesPlayed in
  // worker/nba/routes.js), so no request has to re-read the season from ESPN
  "kv_namespaces": [{ "binding": "NBA", "id": "ce6d02be1cd6431ab8a6c8c7b336b2a9" }],
  "observability": {
    "enabled": true,
  },
}
